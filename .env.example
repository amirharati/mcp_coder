# Copy to .env and fill in (never commit .env — it is gitignored).
# Not required for: pip install, pytest, or MCP server startup.
# Required for: real delegate_to_agent runs (LLM via Aider + OpenRouter).

# --- OpenRouter (default provider for Phase 1) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# API base (LiteLLM/Aider; change if OpenRouter moves endpoints)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# MCP_CODER_OPENROUTER_API_BASE=https://openrouter.ai/api/v1  # alias if OPENROUTER_API_BASE unset

# --- Models (per role — set explicitly; avoid hardcoded provider defaults in code) ---
# Aider requires the openrouter/ prefix. See: https://aider.chat/docs/llms/openrouter.html
# List models: aider --list-models openrouter/
# Test: mcp-coder test-model --model <id>
#
# Executor (implement delegations — Aider Coder):
AIDER_MODEL=openrouter/openai/gpt-4o-mini
# MCP_CODER_MODEL=openrouter/openai/gpt-4o-mini   # alias if AIDER_MODEL unset
#
# Review (mode=review only — spec Q&A):
MCP_CODER_REVIEW_MODEL=openrouter/openai/gpt-4o-mini
#
# Context builder (cheap-LLM brief when context_builder_llm: true):
MCP_CODER_CONTEXT_BUILDER_MODEL=openrouter/google/gemini-2.5-flash
# Optional code fallback when CONTEXT_BUILDER_MODEL + yaml unset (else uses AIDER_MODEL):
# MCP_CODER_CONTEXT_BUILDER_DEFAULT_MODEL=openrouter/google/gemini-2.5-flash
#
# Other executor examples:
# AIDER_MODEL=openrouter/qwen/qwen-2.5-coder-32b-instruct
# AIDER_MODEL=openrouter/deepseek/deepseek-chat-v3.1
# MCP_CODER_REVIEW_MODEL=openrouter/anthropic/claude-3.5-haiku

# --- Executor options (P10-001) ---
# Optional system-prompt prefix prepended by Aider before every message.
# Useful for injecting hard constraints (e.g. "Respect the spec Files contract.").
# MCP_CODER_EXECUTOR_SYSTEM_PREFIX="Respect the spec Files contract."
# Override the Aider edit format (whole | diff | udiff | diff-fenced | …).
# Default: model-native (Aider chooses based on model capability).
# MCP_CODER_EXECUTOR_EDIT_FORMAT=whole

# --- Aider delegation mode (non-interactive; defaults match CLI flags below) ---
# MCP_CODER_AIDER_AUTO_COMMITS=0      # --no-auto-commits
# MCP_CODER_AIDER_DIRTY_COMMITS=0     # --no-dirty-commits
# MCP_CODER_AIDER_USE_GIT=1           # 0 = --no-git
# MCP_CODER_AIDER_SUGGEST_SHELL=0
# MCP_CODER_AIDER_STREAM=0
# MCP_CODER_AIDER_AUTO_LINT=0
# MCP_CODER_AIDER_DETECT_URLS=0       # URL scrape in prompts (default off; set 1 to opt in) [P2-125]

# --- Delegation hardening (P2-125) ---
# MCP_CODER_DELEGATION_TIMEOUT_S=120   # max seconds per engine run (default 120)
# MCP_CODER_ERROR_OUTPUT_MAX_CHARS=2000 # max chars of error output returned to Cursor

# --- Other providers (optional; set AIDER_MODEL to a non-openrouter id) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- mcp-coder storage ---
# User-home store (canonical logs + sessions)
MCP_CODER_HOME=~/.mcp-coder

# Optional: also append to workspace .mcp-coder/logs/delegations.jsonl
# MCP_CODER_MIRROR_LOGS_TO_WORKSPACE=0

# Mirror target when set (canonical remains under MCP_CODER_HOME)
# MCP_CODER_LOG_DIR=

# --- mcp-coder (all optional) ---
# MCP_CODER_DEFAULT_BACKEND=aider
# MCP_CODER_SESSION_POLICY=always_new   # always_new | align_host (default: always_new)
# MCP_CODER_FALLBACK_SESSION=always_new # deprecated; use MCP_CODER_SESSION_POLICY
# MCP_CODER_HOST_TIE_WINDOW_SEC=10     # host transcript scoring tie window (seconds)
# MCP_CODER_HOST_TRANSCRIPT=none        # none (default) | dump — full Cursor chat prepend
# MCP_CODER_MAX_TRANSCRIPT_BYTES=0      # only when dump; 0/unset = no cap (tail chop when set)
# MCP_CODER_SYNC_CURSOR_RULE=1         # sync bundled .cursor/rules/*.mdc on MCP startup (default on)
# MCP_CODER_CURSOR_RULES_POLICY=default  # default | strict (workspace config.yaml wins)
# MCP_CODER_SINGLETON=1                # kill stale stdio server for same workspace on startup
# MCP_CODER_WORKSPACE=
# MCP_CODER_LOG_BRIEF=1          # stderr receive/send lines (default on)
# MCP_CODER_LOG_VERBOSE=1        # extra line when JSONL row is written
# MCP_CODER_LOG_FULL_PROMPT=1
# MCP_CODER_SERVER_LOG=1         # structured server audit log (default on)
# MCP_CODER_SERVER_LOG_LEVEL=info   # error|warn|info|debug
# MCP_CODER_SERVER_LOG_SCOPE=global # global|project|both
# MCP_CODER_SERVER_LOG_MAX_MB=      # not implemented (rotation stub)
# MCP_CODER_PROXY_ENABLED=1         # 0 disables local proxy bootstrap + API_BASE override
# MCP_CODER_ENV_FILE=/path/to/.env
# MCP_CODER_OBS_VERBOSITY=standard  # lean|standard|full (yaml observability_verbosity wins)
# MCP_CODER_OBS_RETENTION=session   # session|forever|<N>_days (policy stub)
# MCP_CODER_CAPTURE_REASONING=1     # 0 disables reasoning payload capture
# MCP_CODER_REASONING_BUFFER_SIZE=3 # in-session reasoning summary ring size
# MCP_CODER_CAPTURE_FOR_TRAINING=0  # 1 enables training capture write path

# --- Context compiler (L2) ---
# MCP_CODER_READ_FULL_MAX_BYTES=8192   # read paths larger than this are excerpted (read-excerpt tier); default 8192
# MCP_CODER_USE_CONTEXT_PACKAGE=1      # 0/false/no disables L2→L3 context package path; falls back to legacy engine.run()
# MCP_CODER_AUTO_MERGE_SPEC_READ=1     # 0/false/no disables auto-merge of spec files_read into target_files (yaml wins)
# MCP_CODER_RAG_ENABLED=1              # 0/false/no disables delegation FTS5 index + rag_search (yaml rag_enabled wins)

# --- Pre-delegate spec validation (P4-009; opt-in) ---
# MCP_CODER_SPEC_VALIDATION=1          # 0/false/no disables; yaml spec_validation wins when set
# Requires host_transcript: dump (or MCP_CODER_HOST_TRANSCRIPT=dump) for useful validation.

# --- Architect pass (P4-020; opt-in) ---
# MCP_CODER_ARCHITECT_PASS=1           # 0/false/no disables; yaml architect_pass wins
# Uses ROLE_CONTEXT_BUILDER model; injects "## Architect plan" above builder/mechanical brief.

# --- Post-delegate verify (P4-010; opt-in) ---
# MCP_CODER_AUTO_VERIFY=1              # 0/false/no disables; yaml auto_verify wins when set
# MCP_CODER_VERIFY_COMMAND=pytest -q   # default when auto_verify on; yaml verify_command wins
# MCP_CODER_VERIFY_TIMEOUT_S=120       # subprocess timeout; yaml verify_timeout_s wins

# --- Context window budget (P2-220) ---
# MCP_CODER_CONTEXT_BUDGET_ENABLED=1   # 0/false/no disables budget enforcement entirely (default: on)
# MCP_CODER_CONTEXT_BUDGET_TOKENS=     # global fallback budget in tokens when model not in model_rates.yaml
#                                       # per-model budgets live in resources/model_rates.yaml (context_budget_tokens)
#                                       # default when model unknown and env unset: 128000

# --- Host adapter ---
# MCP_CODER_HOST=auto              # auto | cursor | none
# MCP_CODER_CURSOR_ROOT=~/.cursor
# MCP_CODER_CURSOR_PROJECT_SLUG=Users-you-projects-myrepo

# Workspace repo settings: copy resources/examples/config.yaml → <workspace>/.mcp-coder/config.yaml
