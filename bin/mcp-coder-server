#!/usr/bin/env bash
# mcp-coder-server — auto-restart wrapper for the mcp-coder stdio MCP server.
# Cursor connects to this wrapper; if main.py exits for any reason, the wrapper
# stays alive and restarts main.py so the next tool call succeeds without a
# manual Cursor MCP refresh.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
MAIN_PY="$REPO_DIR/main.py"

# Prefer the repo's own venv if present; fall back to whatever python is in PATH.
VENV_PY="$REPO_DIR/.venv/bin/python"
if [ -x "$VENV_PY" ]; then
    PYTHON="$VENV_PY"
else
    PYTHON="python"
fi

while true; do
    "$PYTHON" "$MAIN_PY" "$@"
    exit_code=$?
    # Clean SIGTERM (143) or SIGINT (130) from the user — stop the loop.
    if [ "$exit_code" -eq 130 ] || [ "$exit_code" -eq 143 ]; then
        exit "$exit_code"
    fi
    # Any other exit (0 = benign disconnect, non-zero = crash) — restart.
    echo "[mcp-coder] server exited (code=$exit_code); restarting…" >&2
    sleep 0.5
done
