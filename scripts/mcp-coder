#!/usr/bin/env bash
# Run mcp-coder CLI from any workspace without activating the repo venv.
set -euo pipefail

REPO_ROOT="${MCP_CODER_REPO_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
PYTHON="$REPO_ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "mcp-coder: missing venv at $REPO_ROOT/.venv" >&2
  echo "Run: $REPO_ROOT/scripts/bootstrap.sh" >&2
  exit 1
fi

if [[ -n "${MCP_CODER_ENV_FILE:-}" && -f "$MCP_CODER_ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$MCP_CODER_ENV_FILE"
  set +a
elif [[ -f "$REPO_ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO_ROOT/.env"
  set +a
fi

exec "$PYTHON" "$REPO_ROOT/main.py" "$@"
