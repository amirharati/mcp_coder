#!/usr/bin/env bash
# Run mcp-coder CLI from any workspace without activating the repo venv.
set -euo pipefail

# Resolve symlinks (e.g. /usr/local/bin/mcp-coder → repo/scripts/mcp-coder).
_script="${BASH_SOURCE[0]}"
while [[ -L "$_script" ]]; do
  _dir="$(cd -P "$(dirname "$_script")" && pwd)"
  _script="$(readlink "$_script")"
  [[ "$_script" != /* ]] && _script="$_dir/$_script"
done
_script_dir="$(cd -P "$(dirname "$_script")" && pwd)"

REPO_ROOT="${MCP_CODER_REPO_ROOT:-$(cd "$_script_dir/.." && pwd)}"
PYTHON="$REPO_ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "mcp-coder: missing venv at $REPO_ROOT/.venv" >&2
  echo "Run: $REPO_ROOT/scripts/bootstrap.sh" >&2
  exit 1
fi

if [[ -n "${MCP_CODER_ENV_FILE:-}" && -f "$MCP_CODER_ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$MCP_CODER_ENV_FILE"
  set +a
elif [[ -f "$REPO_ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO_ROOT/.env"
  set +a
fi

# MCP stdio server (no args): auto-restart loop (P15-ISS-027).
# Cursor's MCP V2 client closes the stdio pipe ~1s after each delegation
# completes (FSM conn=degraded -> closed); main.py catches the resulting
# BrokenResourceError (P15-012) and exits 0. Without a loop the process is
# gone and Cursor must respawn it lazily — sometimes it doesn't, leaving the
# host on "Not connected" until a manual refresh. The loop brings the server
# back in ~0.5s so the next tool call lands on a ready process.
if [[ $# -eq 0 ]]; then
  set +e
  while true; do
    "$PYTHON" "$REPO_ROOT/main.py" --mcp
    _exit=$?
    # Clean SIGINT (130) / SIGTERM (143) from the user — stop the loop.
    if [[ "$_exit" -eq 130 || "$_exit" -eq 143 ]]; then
      exit "$_exit"
    fi
    echo "[mcp-coder] server exited (code=$_exit); restarting…" >&2
    sleep 0.5
  done
fi
exec "$PYTHON" "$REPO_ROOT/main.py" "$@"
